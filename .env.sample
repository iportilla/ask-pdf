# --- OpenAI (cloud) -- required for the "OpenAI (cloud)" provider ---
OPENAI_API_KEY="OPENAI_API_KEY"

# --- Azure OpenAI / Azure AI Foundry -- required for the "Azure OpenAI / AI Foundry" provider ---
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT="https://YOUR-RESOURCE-NAME.openai.azure.com"
AZURE_OPENAI_API_VERSION="2024-02-15-preview"
AZURE_OPENAI_LLM_DEPLOYMENT="your-chat-deployment-name"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="your-embedding-deployment-name"

# --- Ollama (local) -- required for the "Ollama (local)" provider ---
# Run `ollama serve` and `ollama pull <model>` first. Defaults below assume
# a local server; only change these if Ollama runs elsewhere.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
